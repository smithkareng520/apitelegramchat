```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled Python files
*.cpython-*.pyc
*.pyc
*.pyo
*.pyd

# Development and testing
.venv/
venv/
.env
.env.local
.env.*
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs
*.log

# Temporary files
*.tmp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
```