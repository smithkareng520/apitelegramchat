# =====================================================================
# .dockerignore — 防止构建镜像时泄漏敏感文件
# =====================================================================
# 任何不进容器运行时的文件都应在此排除：
# 1. 防止源码 / .env / .git 进镜像（信息泄漏）
# 2. 减小镜像体积（构建更快、攻击面更小）
# =====================================================================

# ---------- 版本控制 ----------
.git
.gitignore
.gitattributes

# ---------- 敏感配置 ----------
.env
.env.*
*.env
secrets/
*.key
*.pem
*.p12
*.pfx

# ---------- 凭证 / 令牌 ----------
whitelist.txt
token*
credentials*
service-account*.json

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------- 测试 / 覆盖率 ----------
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/

# ---------- 日志 ----------
*.log
logs/
logs-*/
workspace/

# ---------- 虚拟环境 ----------
venv/
env/
ENV/
.venv/

# ---------- 文档 ----------
*.md
!README*.md
!.claude/
!.claude/**
docs/

# ---------- 部署 / CI ----------
render.yaml
docker-compose*.yml
Dockerfile*
.dockerignore

# ---------- 临时文件 ----------
*.tmp
*.bak
*.orig
tmp/
temp/

# ---------- 操作系统 ----------
Thumbs.db
Desktop.ini
